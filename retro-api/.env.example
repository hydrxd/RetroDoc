# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_KEY=

# Optional: vision model used to answer queries (must accept image input)
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct

# Optional: full path to tesseract if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: comma-separated origins allowed to call the API (default *)
# CORS_ORIGINS=http://localhost:5173
